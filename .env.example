# Postgres connection string (Vercel Postgres, Neon, Supabase, RDS…)
DATABASE_URL=postgres://user:password@host:5432/honto
# Set to "false" only for a local Postgres without SSL
DATABASE_SSL=true

# Resend (https://resend.com) — sends each submission to the team and the report to the prospect
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (CONTACT_FROM_EMAIL also works)
EMAIL_FROM=Honto <demo@honto.ai>
# Comma-separated list of people notified on every submission
NOTIFY_EMAILS=fegloff@gmail.com,aumerez@honto.ai

# Your Calendly event link, e.g. https://calendly.com/honto/demo
NEXT_PUBLIC_CALENDLY_URL=
# Optional: Calendly personal access token, used to read the booked time
CALENDLY_TOKEN=

# Public site URL, used in emails
NEXT_PUBLIC_SITE_URL=https://honto.ai

# Login for /admin (Prospects)
ADMIN_USER=honto
ADMIN_PASSWORD=change-me
